  "contract": {
    "accept": "The URL itself contains one public, coherent work that can be read from start to finish.",
    "reject": "The URL is a catalog, index, page shell, login, error, or fragment rather than the work itself.",
    "fetch_reject": "The URL should be rejected before the readability model because it is not a supported readable source type."
  },
